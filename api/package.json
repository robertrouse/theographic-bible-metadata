    "test:verbose": "node --test --test-reporter=spec tests/graphql.test.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "graphql": "^16.15.0",
    "graphql-tag": "^2.12.6"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@graphql-tools/utils": "12.0.2"
  }
}
